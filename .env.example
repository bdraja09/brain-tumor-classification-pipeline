# --- Placement des nœuds : QUEL JEU DE NŒUDS TOURNE SUR CETTE MACHINE ---
#   machine-a : detection-1, segmentation-2, classification-2
#   machine-b : detection-2, segmentation-1, classification-1
COMPOSE_PROFILES=machine-a

# --- Modèles (dossier et noms de fichiers, relatifs à MODELS_DIR) ---
MODELS_DIR=./models
DET_MODEL_FILE=tumor_detection_model.h5
CLS_MODEL_FILE=brain_tumor_rf/random_forest.joblib

# --- Paramètres des nœuds ---
DET_THRESHOLD=0.4
SEG_THRESHOLD=180
TF_THREADS=2

# Capacité d'un réplica : nombre de traitements simultanés
MAX_CONCURRENCY=1

# Délai artificiel (ms) ajouté à chaque requête : rend la répartition visible en démo
DELAY_MS=0

# --- Ressources par conteneur (imitent de petits nœuds fog) ---
DET_CPUS=2.0
DET_MEM=2g
SEG_CPUS=0.5
SEG_MEM=512m
CLS_CPUS=1.0
CLS_MEM=1g
